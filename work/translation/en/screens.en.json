   "source_sha256": "bbc9db3dd1e9150e9c81ac31b90e5bdb6919e39ecb038a0f6e689a1756b85281",
   "source_size": 5,
   "en": "Attack",
   "full_en": "Attack",
   "decision": "Attack is the complete nominal/action label and a natural phase-name component."
  },
  {
