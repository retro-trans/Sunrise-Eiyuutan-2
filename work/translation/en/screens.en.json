   "source_sha256": "6443330dc53ba308305703201cefe72569f47c2fd6bf2d7d4c7ff231cd5695b4",
   "source_size": 5,
   "en": "Defense",
   "full_en": "Defense",
   "decision": "Defense is the complete nominal/action label and a natural phase-name component."
  }
 ],
 "help_rows": [
  {
   "id": 0,
   "source_sha256": "b297b7bc120845c7f9f1aefdc4d16964c1b8e65f3aec79a8c2d7ff26ef20391d",
   "source_size": 429,
   "en": "\n{C:819782960100}:\nHead into the city.\n\nOrganize units for use in battle.\n\nBuy and sell equipment and items.\nOnce allies in the city tell you about a shop,\nyou can visit it until you leave port.\n\nModify units.\n\nLevel up pilots.\n\nRepair the battleship and restore its HP.\n\nView information on allies and machines.\n\nSave or load your game,\nor change system settings.\n\nChoose a city or continent\nto display a guide on the radar.\n\n{C:819782960100}: Leave port.\n\n{x00}"
  },
  {
   "id": 1,
   "source_sha256": "26a9c2a5bf4797b4b39e1aed1b031598c0bbd1a4cd9240c7499b82683ec135b7",
   "source_size": 22,
   "en": "\nResume sailing.\n\n\n\n{x00}"
  },
  {
   "id": 2,
   "source_sha256": "e5a5a98c76cb0bd1ebcc0d12b42284cb27b1d1f87d8f83ec526162e4d4d32d74",
   "source_size": 30,
   "en": "\nSave your progress.\n\n{x00}"
  },
  {
   "id": 3,
   "source_sha256": "327142cf9645b1740e857bdc34c76e2d36ef973f8e62d0b14278e77cfa3b6d97",
   "source_size": 30,
   "en": "\nLoad your saved progress.\n\n{x00}"
  },
  {
   "id": 4,
   "source_sha256": "7d724b793b00f201b541088609290cd40692b31aa96b248ff3c43416a3a9fd2f",
   "source_size": 34,
   "en": "\nChange game settings.\n\n{x00}"
  },
  {
   "id": 5,
   "source_sha256": "83938d32d5555fd1b0ee8a9ed11b57fff9dfe4d52b60802dddbc34911bbb8069",
   "source_size": 39,
   "en": "\nEnd the game and return to the title screen.\n\n\n{x00}"
  },
  {
   "id": 6,
   "source_sha256": "ebd9f6edd6c3514574c9bd1f92b450b147375c906ca501d55380abc6b817352f",
   "source_size": 28,
   "en": "\nYou cannot save right now.\n\n{x00}"
  },
  {
   "id": 7,
   "source_sha256": "78852f61f4c01cf2ffe80d8ed527126f72936172d28fe2c7d5d50f5fd0536931",
   "source_size": 28,
   "en": "\nYou cannot load right now.\n\n{x00}"
  },
  {
   "id": 8,
   "source_sha256": "7d724b793b00f201b541088609290cd40692b31aa96b248ff3c43416a3a9fd2f",
   "source_size": 34,
   "en": "\nChange game settings.\n\n{x00}"
  },
  {
   "id": 9,
   "source_sha256": "20bc437a68b9da62ce30f73efe690b8fc3d7a44340ff5034035a028e34ffe9ac",
   "source_size": 32,
   "en": "\nYou cannot quit right now.\n\n{x00}"
  },
  {
   "id": 10,
   "source_sha256": "b0abb5cbe8ab91aed078f2db578918162f12f23fe9f34bf0da70763693273775",
   "source_size": 192,
   "en": "\nSet the message display speed.\n\nSet the BGM volume.\n\nSet the sound effect volume.\n\nSet the voice volume.\n\nSet the B.E.S volume.\n\nSet the song volume.\n\nSet the movie volume.\n\n{x00}"
  },
  {
   "id": 11,
   "source_sha256": "cd5f73c91d45039e7e1d410770ee2da3815bd0e478814aade12fe2cecc5814ea",
   "source_size": 65,
   "en": "\n{C:81930300}{C:81958296633500000000}We've reached our destination.\n\n{C:81930300}{C:81958296673500000000}We're setting sail.\n\n\n{x00}"
  },
  {
   "id": 12,
   "source_sha256": "5ad11123dc518607d54253029c0f42847ba559fb0becddd11b179a0dbf12a20b",
   "source_size": 46,
   "en": "\n\n{C:81930000}{C:819782830400}{C:819782960100}{C:819782830000}\nhas joined your group.\n\n{x00}"
  },
  {
   "id": 13,
   "source_sha256": "c2f7a6a8b97c84a2ddc4ece9c5883479e4c0992863cb0c6c1f8c557cd3e304d9",
   "source_size": 50,
   "en": "\n\n{C:81930000}{C:819782830400}{C:819782960100}{C:819782830000}\nhas left your group.\n\n\n\n{x00}"
  },
  {
   "id": 14,
   "source_sha256": "f98baeea488c82497713dc67573ce5cb2bb4c374db5990ee4890e95b5df74d5a",
   "source_size": 44,
   "en": "\n\n{C:81930000}{C:819782830400}{C:819782960100}{C:819782830000}\nwas acquired.\n\n{x00}"
  },
  {
   "id": 15,
   "source_sha256": "e6303c08a69f9c7fcf5ecb55d746459ed7cbcd882e8bf7bab22446412f1f6604",
   "source_size": 69,
   "en": "\n\n{C:81930000}{C:819782830400}{C:819782960100}{C:819782830000} has been removed and\ncan no longer be used in unit formation.\n\n\n{x00}"
  },
  {
   "id": 16,
   "source_sha256": "b0d41282d988252f7903e4454831a1aa8ad6cb74182ef8949c11b01c07fe8327",
   "source_size": 61,
   "en": "\n{C:81930000}\n{C:819582860200010002000000}\nSave your current progress?\nYes\nNo\n\n\n{x00}"
  },
  {
   "id": 17,
   "source_sha256": "c3400056499df0deb5d1e17f81c295a1b10c566f9b27aa4ac004835905f35e84",
   "source_size": 30,
   "en": "\nNo information is available about this person.\n\n{x00}"
  },
  {
   "id": 18,
   "source_sha256": "9e8a298f4fc6feb291cefc1603ce01425cd436c9c447a1dd71ee9720fd9d4b09",
   "source_size": 31,
   "en": "\nNo information is available about this machine.\n\n\n{x00}"
  },
  {
   "id": 19,
   "source_sha256": "d9ae61ca6d67dfb38ce05dbaeb3b8af3c09a0b8a94723c6aef6175fa8d9aabec",
   "source_size": 24,
   "en": "\nBuy items.\n\n{x00}"
  },
  {
   "id": 20,
   "source_sha256": "f57cfcbadc2afd1aa44c2d41383549944c6c1134696f3badd06d748d22775423",
   "source_size": 104,
   "en": "\n\nSell items you own.\n(Items with a minimum required stock\ncannot be sold below that quantity.)\n\n\n{x00}"
  },
  {
   "id": 21,
   "source_sha256": "4eb960c3e103683714557e167030388b3eb68f91247b26f80c4350bc0c4984d4",
   "source_size": 107,
   "en": "\nHeroic Tales Mode has been unlocked. Select\n{C:819782830100}Continue{C:819782830000} then\n{C:819782830100}Heroic Tales: Run 1{C:819782830000}.\n\n\n{x00}"
  },
  {
   "id": 22,
   "source_sha256": "f28a7f3cc4664dbded19a09ea474a7ba27c4c84c84ab4b8a744791c13d512f4b",
   "source_size": 27,
   "en": "\n{C:81930000}A large quantity of supplies was brought in.\n{x00}"
  }
 ],
