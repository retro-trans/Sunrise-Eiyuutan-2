   "source_size": 7,
   "en": "Save",
   "full_en": "Save",
   "decision": "Standard Save menu action."
  },
  {
   "id": "ELF/sdata:00000020",
   "va": 2324512,
   "source_sha256": "7a6260c54134a032bdfbe903e0202e4c266fe35b2ef52c9adecb337c4f0182d6",
   "source_size": 7,
   "en": "Load",
   "full_en": "Load",
   "decision": "Standard Load menu action, distinct from saving."
  },
  {
   "id": "ELF/sdata:00000028",
   "va": 2324520,
   "source_sha256": "a1eb935b53b261ea80997978d25fe9aa8c0c35a4969dfea986501df3aa66c22f",
   "source_size": 5,
   "en": "Exit",
   "full_en": "Exit",
   "decision": "Exit is appropriate for the save/load/system menu termination label; not a tactical End Turn."
  },
  {
   "id": "ELF/sdata:00000100",
   "va": 2324736,
   "source_sha256": "7017897ce9b520fe6fbec52fbf8b4c692ae6871232252e47b889f376848d823c",
   "source_size": 5,
   "en": "Yes",
   "full_en": "Yes",
   "decision": "Affirmative answer Yes."
  },
  {
   "id": "ELF/sdata:00000108",
