   "source_size": 20,
   "en": "MEMORY CARD slot 1",
   "full_en": "MEMORY CARD slot 1",
   "decision": "Retain MEMORY CARD device name, slot and exact slot number 1."
  },
  {
   "id": "ELF/data:0001A978",
   "va": 1874296,
   "source_sha256": "002271961e88defb5d324f45e97113bfedd34804dd4d880180ecf16b71f2f364",
   "source_size": 20,
   "en": "MEMORY CARD slot 2",
   "full_en": "MEMORY CARD slot 2",
   "decision": "Retain the distinct exact slot number 2."
  },
  {
   "id": "ELF/sdata:00000018",
   "va": 2324504,
